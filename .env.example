# Optional overrides; copy to .env or export in your shell. rmf reads these from the environment.
# Unset values fall back to portable defaults:
#   RMF_SSSF_SOURCE -> the SSSF skill bundled in this repo (.claude/skills/sssf)
#   RMF_TAC_BIN     -> first rig-tac-os on PATH, else ~/.rig/bin/rig-tac-os
#   RMF_UV_BIN      -> first uv on PATH, else ~/.local/bin/uv
RMF_DB_PATH=~/.rig/meta-factory/registry.db
# RMF_SSSF_SOURCE=/path/to/super-simple-software-factory/.claude/skills/sssf
# RMF_TAC_BIN=~/.rig/bin/rig-tac-os
# RMF_UV_BIN=~/.local/bin/uv
# Orca binary checked before `tac run` and `tac verify` (default: first `orca` on PATH).
# An empty value skips the check.
# RMF_ORCA_BIN=~/.homebrew/bin/orca
# Seconds `tac run` waits for the builder command's exit line (poll every RMF_TAC_POLL_SECONDS, default 5).
# RMF_TAC_WAIT_SECONDS=900
